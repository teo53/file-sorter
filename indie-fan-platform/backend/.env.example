# Database
DATABASE_URL="postgresql://username:password@localhost:5432/indiefan?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=3000
NODE_ENV=development

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Firebase (FCM)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# OAuth - Kakao
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""
KAKAO_CALLBACK_URL="http://localhost:3000/auth/kakao/callback"

# OAuth - Google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"

# OAuth - Apple
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

# Twitter API (for profile import)
TWITTER_BEARER_TOKEN=""

# File Storage (S3 or Supabase)
STORAGE_PROVIDER=local
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-northeast-2"

# Platform Settings
PLATFORM_FEE_PERCENT=20
MIN_SUBSCRIPTION_PRICE=2000
MAX_SUBSCRIPTION_PRICE=10000
DEFAULT_SUBSCRIPTION_PRICE=4900
