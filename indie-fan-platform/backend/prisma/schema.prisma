// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// 사용자 관련 모델
// ============================================

enum UserRole {
  FAN       // 일반 팬 사용자
  ARTIST    // 아티스트
  ADMIN     // 관리자
}

enum UserStatus {
  PENDING   // 승인 대기
  ACTIVE    // 활성
  SUSPENDED // 정지
  DELETED   // 삭제됨
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

model User {
  id                String      @id @default(uuid())
  email             String      @unique
  password          String?     // 소셜 로그인 시 null 가능
  nickname          String
  profileImage      String?
  role              UserRole    @default(FAN)
  status            UserStatus  @default(ACTIVE)
  gender            Gender      @default(UNKNOWN)
  birthDate         DateTime?
  phoneNumber       String?

  // 소셜 로그인 연동
  kakaoId           String?     @unique
  googleId          String?     @unique
  appleId           String?     @unique

  // FCM 푸시 토큰
  fcmToken          String?

  // 설정
  pushEnabled       Boolean     @default(true)
  emailNotification Boolean     @default(true)

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  lastLoginAt       DateTime?

  // Relations
  artistProfile     ArtistProfile?
  subscriptions     Subscription[]      // 팬으로서의 구독 목록
  sentMessages      Message[]           @relation("FanMessages")
  payments          Payment[]
  notifications     Notification[]
  deviceTokens      DeviceToken[]

  @@index([email])
  @@index([kakaoId])
  @@index([googleId])
}

// ============================================
// 아티스트 프로필
// ============================================

enum ArtistCategory {
  IDOL          // 지하 아이돌
  MAID          // 메이드 카페
  COSPLAYER     // 코스어
  STREAMER      // 인터넷 방송인
  OTHER         // 기타
}

enum ArtistStatus {
  PENDING       // 승인 대기
  APPROVED      // 승인됨
  REJECTED      // 거절됨
  SUSPENDED     // 활동 정지
}

model ArtistProfile {
  id                  String          @id @default(uuid())
  userId              String          @unique
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 기본 정보
  stageName           String          // 활동명
  realName            String?         // 실명 (비공개)
  bio                 String?         // 자기소개
  category            ArtistCategory  @default(OTHER)
  status              ArtistStatus    @default(PENDING)

  // 프로필 미디어
  profileImage        String?
  coverImage          String?

  // SNS 연동
  twitterHandle       String?
  instagramHandle     String?
  youtubeChannel      String?
  tiktokHandle        String?

  // 구독 설정
  subscriptionPrice   Int             @default(4900)  // 월 구독료 (원)
  welcomeMessage      String?         // 구독 시 자동 발송 메시지

  // 팬덤 정보
  fandomName          String?         // 팬덤명

  // 통계
  subscriberCount     Int             @default(0)
  totalMessageCount   Int             @default(0)

  // 정산 정보
  bankName            String?
  bankAccount         String?
  bankAccountHolder   String?

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  approvedAt          DateTime?

  // Relations
  subscriptions       Subscription[]
  messages            Message[]       @relation("ArtistMessages")
  mediaContents       MediaContent[]

  @@index([stageName])
  @@index([category])
  @@index([status])
}

// ============================================
// 구독 관련
// ============================================

enum SubscriptionStatus {
  ACTIVE      // 활성
  CANCELLED   // 취소됨
  EXPIRED     // 만료됨
  PAUSED      // 일시정지
}

model Subscription {
  id                String              @id @default(uuid())

  // 관계
  fanId             String
  fan               User                @relation(fields: [fanId], references: [id], onDelete: Cascade)
  artistProfileId   String
  artistProfile     ArtistProfile       @relation(fields: [artistProfileId], references: [id], onDelete: Cascade)

  // 구독 정보
  status            SubscriptionStatus  @default(ACTIVE)
  price             Int                 // 구독 시 가격

  // 기간
  startDate         DateTime            @default(now())
  endDate           DateTime?
  renewalDate       DateTime?

  // 구독 기념일 카운트
  subscribedDays    Int                 @default(0)

  // 결제 연동
  stripeSubscriptionId String?

  // 자동 갱신
  autoRenewal       Boolean             @default(true)

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  cancelledAt       DateTime?

  // Relations
  chatRoom          ChatRoom?
  payments          Payment[]

  @@unique([fanId, artistProfileId])
  @@index([fanId])
  @@index([artistProfileId])
  @@index([status])
}

// ============================================
// 채팅방 및 메시지
// ============================================

model ChatRoom {
  id                String        @id @default(uuid())

  subscriptionId    String        @unique
  subscription      Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  // 읽음 상태
  fanLastReadAt     DateTime?
  artistLastReadAt  DateTime?

  // 팬 답장 제한
  fanReplyCount     Int           @default(0)  // 현재 메시지에 대한 답장 수

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Relations
  messages          Message[]
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  STICKER
}

enum MessageSender {
  ARTIST    // 아티스트가 보낸 메시지
  FAN       // 팬이 보낸 답장
  SYSTEM    // 시스템 메시지 (환영 메시지 등)
}

model Message {
  id                String          @id @default(uuid())

  // 채팅방
  chatRoomId        String
  chatRoom          ChatRoom        @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)

  // 발신자 정보
  senderType        MessageSender
  artistProfileId   String?
  artistProfile     ArtistProfile?  @relation("ArtistMessages", fields: [artistProfileId], references: [id])
  fanUserId         String?
  fanUser           User?           @relation("FanMessages", fields: [fanUserId], references: [id])

  // 메시지 내용
  type              MessageType     @default(TEXT)
  content           String          // 텍스트 또는 미디어 URL

  // 개인화 (팬 닉네임 치환 전 원본)
  originalContent   String?

  // 브로드캐스트 메시지 ID (아티스트가 전체에게 보낸 원본 메시지)
  broadcastId       String?

  // 답장 대상 메시지
  replyToId         String?
  replyTo           Message?        @relation("MessageReplies", fields: [replyToId], references: [id])
  replies           Message[]       @relation("MessageReplies")

  // 읽음 상태
  isRead            Boolean         @default(false)
  readAt            DateTime?

  createdAt         DateTime        @default(now())

  @@index([chatRoomId])
  @@index([broadcastId])
  @@index([createdAt])
}

// 아티스트 브로드캐스트 메시지 (전체 발송 원본)
model BroadcastMessage {
  id                String          @id @default(uuid())

  artistProfileId   String

  type              MessageType     @default(TEXT)
  content           String

  // 발송 통계
  recipientCount    Int             @default(0)
  readCount         Int             @default(0)
  replyCount        Int             @default(0)

  createdAt         DateTime        @default(now())

  @@index([artistProfileId])
  @@index([createdAt])
}

// ============================================
// 미디어 콘텐츠
// ============================================

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
}

model MediaContent {
  id                String        @id @default(uuid())

  artistProfileId   String
  artistProfile     ArtistProfile @relation(fields: [artistProfileId], references: [id], onDelete: Cascade)

  type              MediaType
  url               String
  thumbnailUrl      String?

  // 메타데이터
  fileName          String?
  fileSize          Int?
  duration          Int?          // 영상/음성 길이 (초)
  width             Int?
  height            Int?

  // 공개 설정
  isPublic          Boolean       @default(false)  // 비구독자도 볼 수 있는지

  createdAt         DateTime      @default(now())

  @@index([artistProfileId])
}

// ============================================
// 결제 관련
// ============================================

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentType {
  SUBSCRIPTION        // 구독 결제
  SUBSCRIPTION_RENEWAL // 구독 갱신
  GIFT                // 선물/후원
}

model Payment {
  id                String          @id @default(uuid())

  userId            String
  user              User            @relation(fields: [userId], references: [id])

  subscriptionId    String?
  subscription      Subscription?   @relation(fields: [subscriptionId], references: [id])

  type              PaymentType
  status            PaymentStatus   @default(PENDING)

  amount            Int             // 결제 금액 (원)
  currency          String          @default("KRW")

  // 결제 수단 정보
  paymentMethod     String?         // stripe, iap_ios, iap_android
  stripePaymentId   String?
  iapTransactionId  String?
  iapReceipt        String?

  // 정산 정보
  platformFee       Int?            // 플랫폼 수수료
  artistRevenue     Int?            // 아티스트 수익
  isSettled         Boolean         @default(false)
  settledAt         DateTime?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([userId])
  @@index([subscriptionId])
  @@index([status])
}

// 아티스트 정산 내역
model Settlement {
  id                String          @id @default(uuid())

  artistProfileId   String

  // 정산 기간
  periodStart       DateTime
  periodEnd         DateTime

  // 금액
  totalRevenue      Int             // 총 수익
  platformFee       Int             // 플랫폼 수수료
  netAmount         Int             // 순 정산금

  // 상태
  status            String          @default("PENDING")  // PENDING, PROCESSING, COMPLETED

  // 송금 정보
  transferredAt     DateTime?
  transferReference String?

  createdAt         DateTime        @default(now())

  @@index([artistProfileId])
}

// ============================================
// 알림
// ============================================

enum NotificationType {
  NEW_MESSAGE       // 새 메시지
  NEW_SUBSCRIBER    // 새 구독자
  SUBSCRIPTION_EXPIRING // 구독 만료 예정
  ANNIVERSARY       // 구독 기념일
  SYSTEM            // 시스템 공지
}

model Notification {
  id                String            @id @default(uuid())

  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  type              NotificationType
  title             String
  body              String
  data              Json?             // 추가 데이터

  isRead            Boolean           @default(false)
  readAt            DateTime?

  createdAt         DateTime          @default(now())

  @@index([userId])
  @@index([isRead])
}

// 디바이스 토큰 (푸시 알림용)
model DeviceToken {
  id                String    @id @default(uuid())

  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  token             String
  platform          String    // ios, android, web

  isActive          Boolean   @default(true)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([userId, token])
  @@index([userId])
}

// ============================================
// 신고 및 차단
// ============================================

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

model Report {
  id                String        @id @default(uuid())

  reporterId        String
  targetUserId      String?
  targetMessageId   String?

  reason            String
  description       String?

  status            ReportStatus  @default(PENDING)
  reviewedBy        String?
  reviewNote        String?

  createdAt         DateTime      @default(now())
  reviewedAt        DateTime?

  @@index([status])
}

model BlockedUser {
  id                String    @id @default(uuid())

  blockerId         String
  blockedId         String

  createdAt         DateTime  @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
}
